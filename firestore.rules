rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/progress/course {
      // Public progress is available only to a verified Google account at its
      // exact UID. There is intentionally no list or delete permission.
      allow get: if isVerifiedGoogle(uid);
      allow create, update: if isVerifiedGoogle(uid) && isValidProgress();
    }

    function isVerifiedGoogle(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function isValidProgress() {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'payload', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'payload', 'updatedAt'
        ])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.toUtf8().size() <= 131072
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }
  }
}
